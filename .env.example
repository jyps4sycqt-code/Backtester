# Copy to .env and fill in. Nothing in this repo loads .env automatically;
# export these or use `set -a; source .env; set +a` before running.

# --- Alpaca paper trading (optional) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Optional: turn on real-money mode (off by default; do not enable lightly) ---
TRADER_LIVE_REAL_MONEY=0
